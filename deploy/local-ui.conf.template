server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy no-referrer;

    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control no-store;
        return 200 'window.REPEAT_CONFIG = {roomsOrigin: "http://127.0.0.1:${ROOMS_HOST_PORT}", gameOrigin: "http://127.0.0.1:${GAME_HOST_PORT}"};';
    }

    location ~ \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
